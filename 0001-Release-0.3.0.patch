From e5dad010dcd6e78659677d96c51c25e6f254ada4 Mon Sep 17 00:00:00 2001
From: Mukhtar Lawan <mukhtarlawanphy@gmail.com>
Date: Thu, 15 Oct 2026 11:29:38 +0000
Subject: [PATCH] Release 0.3.0

Bumps the version to 0.3.0 and moves the Unreleased entries into a 0.3.0 section, adding the 2D grid entry that was missing from main. The release contains the 2D k grid in the simulator, its check against im_eps_2d, and the 1.8x speed-up of the 2D propagation.

---
 CHANGELOG.md            | 8 ++++++--
 pyproject.toml          | 2 +-
 src/twoband/__init__.py | 2 +-
 3 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 5efe97e..51ecb26 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -5,11 +5,15 @@ The format follows [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).
 
 ## [Unreleased]
 
-### Changed
-- 2D propagation is about 1.8x faster on a 101 x 101 grid (9.2 s to 5.2 s for 16000 steps). The field and dipole are along x, so ky and -ky points are identical: only ky >= 0 is propagated, with each ky > 0 point counted twice. Results are unchanged to 1e-15 relative.
+## [0.3.0] - 2026-10-15
 
 ### Added
+- Two-dimensional k grid in the simulator: `TwoBandModel` takes `ky_max` and `n_ky`, with the field and the dipole along x. The default `n_ky = 1` keeps the one-dimensional model unchanged. `TwoBandModel.grid()` gives the flattened points and the area element, and the diamagnetic coefficient uses the same grid.
+- Tests for the 2D grid: a complex-valued reference over the full (kx, ky) grid, weak-field linearity, and the static sum rule.
 - Check of the 2D simulator against the analytic `im_eps_2d`: the weak-probe Re[sigma] agrees to 3 % from 6 to 12 eV, with the Lorentzian broadening equal to the damping.
+
+### Changed
+- 2D propagation is about 1.8x faster on a 101 x 101 grid (9.2 s to 5.2 s for 16000 steps). The field and dipole are along x, so ky and -ky points are identical: only ky >= 0 is propagated, with each ky > 0 point counted twice. Results are unchanged to 1e-15 relative.
 - Two-dimensional k grid in the simulator: `TwoBandModel` takes `ky_max` and `n_ky`, with the field and the dipole along x. The default `n_ky = 1` keeps the one-dimensional model unchanged. `TwoBandModel.grid()` gives the flattened points and the area element, and the diamagnetic coefficient uses the same grid.
 - Tests for the 2D grid: a complex-valued reference over the full (kx, ky) grid, weak-field linearity, and the static sum rule.
 
diff --git a/pyproject.toml b/pyproject.toml
index 97e11eb..381f59a 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,7 +4,7 @@ build-backend = "setuptools.build_meta"
 
 [project]
 name = "twoband"
-version = "0.2.1"
+version = "0.3.0"
 description = "Analysis tools for the parabolic two-band model: optical conductivity, dielectric function and transient absorption spectra"
 readme = "README.md"
 requires-python = ">=3.10"
diff --git a/src/twoband/__init__.py b/src/twoband/__init__.py
index 881b35d..3a9c575 100644
--- a/src/twoband/__init__.py
+++ b/src/twoband/__init__.py
@@ -50,4 +50,4 @@ __all__ = [
     "vector_potential",
 ]
 
-__version__ = "0.2.1"
+__version__ = "0.3.0"
